+class RandomGrayscale:
+    """Randomly desaturate the image to grayscale (kept 3-channel), pixel-only.
+
+    Used to make the model robust to vehicle color / monochrome footage. The
+    probability is read from the ``V2_GRAYSCALE_P`` env var (default 0.0 = off) so
+    it needs no new cfg key and still propagates to DDP dataloader workers, which
+    inherit the parent environment. Image-only: boxes and keypoints are untouched,
+    so it is safe for the hybrid pose data.
+    """
+
+    def __init__(self, p: float = 0.0):
+        """Initialize with grayscale probability ``p``."""
+        self.p = p
+
+    def __call__(self, labels):
+        """Convert the image to 3-channel grayscale with probability ``p``."""
+        if self.p and np.random.rand() < self.p:
+            img = labels["img"]
+            if img.ndim == 3 and img.shape[-1] == 3:
+                gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
+                labels["img"] = cv2.cvtColor(gray, cv2.COLOR_GRAY2BGR)
+        return labels
+
